# Published amd64 images. Apple Silicon uses the compatibility overlay via sim.sh.
SIM_IMAGE=ilyawwww/sverk-ros2:v1.9-sim
SIM_IMAGE_NOVNC=ilyawwww/sverk-ros2:v1.9-sim-novnc
SIM_IMAGE_IDE=ilyawwww/sverk-ros2:v1.9-sim-ide
SIM_IMAGE_MCP=ilyawwww/sverk-ros2:v1.9-sim-mcp

# Optional CPU-render settings (tune after measuring performance).
VNC_RESOLUTION=1920x1080x24
LP_NUM_THREADS=4
